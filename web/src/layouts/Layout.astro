---
import '../styles/global.css';
import SyncStatus from '../components/SyncStatus.svelte';
import InstallPrompt from '../components/InstallPrompt.svelte';

interface Props {
  title?: string;
  nav?: boolean;
  wide?: boolean;
}
const { title, nav = true, wide = false } = Astro.props;
const path = Astro.url.pathname;
const tabs = [
  { href: '/', label: 'Home', icon: 'M3 11l9-8 9 8v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z' },
  { href: '/daily', label: 'Daily', icon: 'M12 6v6l4 2M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z' },
  { href: '/drills', label: 'Drills', icon: 'M4 14c2-6 4-6 6 0s4 6 6 0 3-5 4-2' },
  { href: '/yap', label: 'Yap', icon: 'M5 5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-7l-5 4v-4H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z' },
  { href: '/everyday', label: 'Everyday', icon: 'M12 2a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3zM5 11a7 7 0 0 0 14 0M12 18v4' },
];
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#2f6f5e" />
    <meta name="description" content="Voice tonality and yapping stamina trainer" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{title ? `${title} · Yapp` : 'Yapp'}</title>
    <script is:inline>
      try { const t = localStorage.getItem('yapp-theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
      // Chromium fires this early, often before islands hydrate; keep it for InstallPrompt.svelte.
      addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); window.__yappInstall = e; dispatchEvent(new Event('yapp-installable')); });
      if ('serviceWorker' in navigator) addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
        // once per tab session (logged-in pages only): cache the main pages for offline use
        if (location.pathname !== '/login' && !sessionStorage.getItem('yapp-warm')) {
          navigator.serviceWorker.ready.then((r) => { r.active?.postMessage('warm'); sessionStorage.setItem('yapp-warm', '1'); }).catch(() => {});
        }
      });
    </script>
  </head>
  <body class="min-h-dvh">
    {nav && (
      <header class="sticky top-0 z-20 border-b border-line bg-bg/90 backdrop-blur">
        <div class={`mx-auto flex items-center gap-3 px-4 py-2.5 ${wide ? 'max-w-5xl' : 'max-w-3xl'}`}>
          <a href="/" class="flex items-center gap-2 font-bold"><img src="/favicon.svg" alt="" class="h-7 w-7" />Yapp</a>
          <nav class="ml-4 hidden gap-1 md:flex">
            {tabs.map((t) => <a href={t.href} class={`rounded-lg px-3 py-1.5 text-sm ${active(t.href) ? 'bg-surface-2 font-semibold' : 'text-muted hover:text-fg'}`}>{t.label}</a>)}
          </nav>
          <div class="ml-auto flex items-center gap-1">
            <SyncStatus client:idle />
            <a href="/history" class={`rounded-lg px-2.5 py-1.5 text-sm ${active('/history') ? 'font-semibold' : 'text-muted'}`}>History</a>
            <a href="/settings" aria-label="Settings" class="rounded-lg p-1.5 text-muted hover:text-fg">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
            </a>
          </div>
        </div>
      </header>
    )}
    <main class={`mx-auto px-4 pb-28 pt-4 md:pb-10 ${wide ? 'max-w-5xl' : 'max-w-3xl'}`}>
      <slot />
    </main>
    {nav && (
      <nav class="fixed inset-x-0 bottom-0 z-20 border-t border-line bg-bg/95 pb-[env(safe-area-inset-bottom)] backdrop-blur md:hidden">
        <div class="mx-auto grid max-w-md grid-cols-5">
          {tabs.map((t) => (
            <a href={t.href} class={`flex flex-col items-center gap-0.5 py-2 text-[11px] ${active(t.href) ? 'text-accent font-semibold' : 'text-muted'}`}>
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={t.icon} /></svg>
              {t.label}
            </a>
          ))}
        </div>
      </nav>
    )}
    {nav && <InstallPrompt client:idle />}
  </body>
</html>
