---
import Layout from '../../layouts/Layout.astro';
import { DRILLS, STEP_HOME, STEP_TASKS } from '../../lib/drill-plan';
import { TONALITY_STEPS, MASTERY_WINDOW } from '../../lib/progression';
import { appState } from '../../lib/server/stats';

const s = appState();
const step = s.tonality.step;
const m = s.tonality.mastery;
const pct = Math.round(m.rate * 100);
const fbText = { continuous: 'live feedback', summary: 'summary feedback only', none: 'no feedback (confirmation reps)' }[s.tonality.feedback];
const currentHref = STEP_HOME[step] ?? '/drills';

// One card per progression step, in order; drills outside the progression are listed separately.
const LATER_STEPS: Record<number, { desc: string; why: string }> = {
  9: { desc: 'Talk with an AI partner who answers back.', why: 'Conversation is where a flat voice and fillers actually happen. A partner makes you plan and deliver at the same time, without real-life stakes.' },
  10: { desc: 'Record a short recap after real conversations.', why: 'The real test: it shows whether your practice voice turns up in everyday talk.' },
};
const stepCards = TONALITY_STEPS.map((t) => {
  const drill = DRILLS.find((d) => d.steps.length === 1 && d.steps[0] === t.step);
  const info = drill ?? (STEP_TASKS[t.step] ? { desc: STEP_TASKS[t.step].how, why: STEP_TASKS[t.step].why } : LATER_STEPS[t.step]);
  return { step: t.step, name: t.name, href: STEP_HOME[t.step], desc: info.desc, why: info.why };
});
const extras = DRILLS.filter((d) => d.steps.length === 0);
// Same gating and labels as Daily → More.
const av = s.availability;
const item = (id: string) => av.more.find((i) => i.id === id);
const chip: Record<string, string> = { due: 'border-warn text-warn', available: 'border-accent text-accent', done: 'border-good text-good', locked: '' };
const transfer = item('transfer');
---
<Layout title="Drills">
  <h1 class="mb-1 text-2xl font-bold">Tonality drills</h1>
  <p class="mb-4 text-muted">Advance a step when 80% of your last {MASTERY_WINDOW} reps there are on target.</p>

  <a href={currentHref} class="card mb-4 block space-y-3 border-accent">
    <div class="flex items-center gap-3">
      <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-accent text-xl font-black text-accent-fg">{step}</div>
      <div class="min-w-0 flex-1">
        <div class="label">Current step</div>
        <div class="font-semibold">{s.tonality.name}</div>
        <div class="text-xs text-muted">{fbText}</div>
      </div>
      <span class="btn btn-primary shrink-0">Practise</span>
    </div>
    <div>
      <div class="mb-1 flex justify-between text-xs text-muted">
        <span>Mastery {pct}%</span>
        <span>{Math.min(m.count, MASTERY_WINDOW)}/{MASTERY_WINDOW} reps</span>
      </div>
      <div class="relative h-2.5 overflow-hidden rounded-full bg-surface-2">
        <div class={`h-full rounded-full ${pct >= 80 ? 'bg-good' : 'bg-accent'}`} style={`width:${pct}%`}></div>
        <div class="absolute inset-y-0 w-0.5 bg-fg/40" style="left:80%" title="80% mastery"></div>
      </div>
    </div>
  </a>

  <h2 class="mb-2 text-lg font-bold">Progression</h2>
  <div class="space-y-3">
    {stepCards.map((c) => {
      const current = c.step === step;
      const done = c.step < step;
      return (
        <a href={c.href} class={`card flex items-center gap-4 ${current ? 'border-accent' : ''}`}>
          <div class={`grid h-11 w-11 shrink-0 place-items-center rounded-xl text-sm font-black ${current ? 'bg-accent text-accent-fg' : done ? 'bg-good text-white' : 'bg-surface-2'}`}>
            {done ? '✓' : c.step}
          </div>
          <div class="min-w-0 flex-1">
            <div class="font-semibold">{c.name} {current && <span class="chip ml-1 border-accent text-accent">now · counts toward mastery</span>}{c.step === 8 && <span class="chip ml-1">also: retell tellings in the daily base</span>}</div>
            <div class="text-sm text-muted">{c.desc}</div>
            <div class="mt-1 text-xs text-muted">{c.why}</div>
          </div>
        </a>
      );
    })}
  </div>

  <h2 class="mb-2 mt-8 text-lg font-bold">Extra drills</h2>
  <div class="space-y-3">
    {extras.map((d) => (
      <a href={d.href} class="card block">
        <div class="flex flex-wrap items-center gap-2 font-semibold">{d.title} {item(d.id) && <span class={`chip ${chip[item(d.id)!.status]}`}>{item(d.id)!.status} · {item(d.id)!.countsToward.join(', ')}</span>}</div>
        <div class="text-sm text-muted">{d.desc}</div>
        <div class="mt-1 text-xs text-muted">{d.why}</div>
      </a>
    ))}
  </div>

  <h2 class="mb-2 mt-8 text-lg font-bold">Sessions</h2>
  <div class="grid gap-3 sm:grid-cols-3">
    <a href="/daily" class={`card ${av.base.done ? '' : 'border-accent'}`}><div class="font-semibold">Daily {av.base.done ? <span class="chip ml-1 border-good text-good">base done</span> : <span class="chip ml-1 border-accent text-accent">base to do</span>}</div><div class="text-sm text-muted">~18 min base, then extras in More.</div></a>
    <a href="/transfer" class={`card ${s.transferDue ? 'border-warn' : ''}`}><div class="font-semibold">Transfer test {transfer && <span class={`chip ml-1 ${chip[transfer.status]}`}>{transfer.status === 'locked' ? transfer.reason : transfer.status}</span>}</div><div class="text-sm text-muted">Weekly 2-min monologue, no feedback.</div></a>
    <a href="/calibrate" class={`card ${!s.baseline ? 'border-warn' : ''}`}><div class="font-semibold">Calibrate {!s.baseline && <span class="chip ml-1 border-warn text-warn">needed</span>}</div><div class="text-sm text-muted">Baseline: 60 s talk + reading.</div></a>
  </div>

</Layout>
