# --- Auth -------------------------------------------------------------------
# Generate with:  npm --prefix web install && npm --prefix web run hash-password
# Keep the single quotes (docker compose would otherwise expand the $ signs).
APP_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$CHANGE_ME'

# --- HTTPS certificate --------------------------------------------------------
# Extra DNS names for the leaf certificate (comma separated), e.g. yapp.lan,myhost.local
HOSTNAMES=
# LAN IPs to include. Empty = auto-detect all of the host's interfaces at start-up.
LAN_IPS=

# --- Network -----------------------------------------------------------------------
# Address(es) the HTTP + HTTPS servers listen on (host networking), comma separated.
# 0.0.0.0 = every interface; e.g. 10.0.0.1,127.0.0.1 = WireGuard + localhost only.
# voice-lab always stays on 127.0.0.1.
BIND_HOST=0.0.0.0

# --- Ports ----------------------------------------------------------------------
HTTP_PORT=8080
HTTPS_PORT=8443
VOICE_LAB_PORT=8765

# --- Models -----------------------------------------------------------------------
# Ollama on the host (web uses host networking, so 127.0.0.1 reaches it).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# faster-whisper model: large-v3-turbo (GPU) | small / base (CPU)
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto

# --- Misc -----------------------------------------------------------------------
# Local timezone for streak days and the daily push time.
TZ=America/New_York
# Contact sent to push services in the VAPID JWT. Must be a real-looking mailto:/https: URL —
# Apple (Safari/iOS) rejects "localhost" with 403 BadJwtToken.
VAPID_SUBJECT=mailto:yapp@example.com
