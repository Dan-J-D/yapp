---
import Layout from '../layouts/Layout.astro';
import DailySession from '../components/drills/DailySession.svelte';
---
<Layout title="Daily session">
  <h1 class="mb-1 text-2xl font-bold">Daily session</h1>
  <p class="mb-4 text-sm text-muted">The one place to train: an ~18-minute base every day (high effort, many reps, one simple cue at a time), then optional extras that respect the come-back-tomorrow pacing.</p>
  <DailySession client:only="svelte" />
</Layout>
